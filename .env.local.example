# Supabase — create a project at supabase.com, then paste its keys here
# (Project Settings → API). Copy this file to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Maps (optional) — enables auto distance/time on routes.
# Create a key in Google Cloud Console with the "Distance Matrix API" enabled.
GOOGLE_MAPS_API_KEY=

# Backup export token (optional but recommended once real data is in).
# A long random string; the /api/export endpoint requires ?token=this.
# See GOOGLE_SHEETS_BACKUP.md.
BACKUP_EXPORT_TOKEN=

# "Back up to Sheet now" button (push model). Deploy your Google Sheet's
# Apps Script as a Web App and paste its URL here. Optional shared secret
# must match the SECRET in the script. See GOOGLE_SHEETS_BACKUP.md.
GOOGLE_SHEETS_WEBHOOK_URL=
BACKUP_WEBHOOK_SECRET=
